{
  "info": {
    "name": "EduPilot Student API - Mobile Mock",
    "_postman_id": "edupilot-student-mobile-mock",
    "description": "Postman collection for EduPilot student mobile APIs. Use with a local mock server (Prism) or Postman mock service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student1@example.com\",\n  \"password\": \"pass123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login/", "host": ["{{baseUrl}}"], "path": ["auth","login",""] }
          },
          "response": []
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/refresh/", "host": ["{{baseUrl}}"], "path": ["auth","refresh",""] }
          }
        }
      ]
    },
    {
      "name": "Student",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/student/profile/", "host": ["{{baseUrl}}"], "path": ["student","profile",""] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Ali Khan Updated\"\n}" },
            "url": { "raw": "{{baseUrl}}/student/profile/", "host": ["{{baseUrl}}"], "path": ["student","profile",""] }
          }
        }
      ]
    },
    {
      "name": "Fees",
      "item": [
        {
          "name": "List Vouchers",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/fees/vouchers/?status=UNPAID&page=1&page_size=20", "host": ["{{baseUrl}}"], "path": ["fees","vouchers",""], "query": [ { "key": "status", "value": "UNPAID" }, { "key": "page", "value": "1" }, { "key": "page_size", "value": "20" } ] }
          }
        },
        {
          "name": "Voucher Detail",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/fees/vouchers/{{voucher_no}}/", "host": ["{{baseUrl}}"], "path": ["fees","vouchers","{{voucher_no}}",""] }
          }
        },
        {
          "name": "Get Balance",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/fees/balance/", "host": ["{{baseUrl}}"], "path": ["fees","balance",""] }
          }
        },
        {
          "name": "Start Payment",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"voucher_no\": \"V-2026-07-001\",\n  \"payment_method\": \"stripe\",\n  \"payment_token\": \"tok_test_123\"\n}" },
            "url": { "raw": "{{baseUrl}}/fees/pay/", "host": ["{{baseUrl}}"], "path": ["fees","pay",""] }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/notifications/?page=1&page_size=20", "host": ["{{baseUrl}}"], "path": ["notifications",""], "query": [ { "key": "page", "value": "1" }, { "key": "page_size", "value": "20" } ] }
          }
        },
        {
          "name": "Mark Notification Read",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/notifications/{{notification_id}}/mark-read/", "host": ["{{baseUrl}}"], "path": ["notifications","{{notification_id}}","mark-read",""] }
          }
        },
        {
          "name": "Register Device",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"device_id\": \"device-uuid-123\",\n  \"platform\": \"android\",\n  \"push_token\": \"push_token_example\"\n}" },
            "url": { "raw": "{{baseUrl}}/device/register/", "host": ["{{baseUrl}}"], "path": ["device","register",""] }
          }
        }
      ]
    },
    {
      "name": "Timetable",
      "item": [
        {
          "name": "Week Timetable",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/timetable/week/?start_date=2026-08-23", "host": ["{{baseUrl}}"], "path": ["timetable","week",""], "query": [ { "key": "start_date", "value": "2026-08-23" } ] }
          }
        },
        {
          "name": "Day Timetable",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/timetable/day/?date=2026-08-24", "host": ["{{baseUrl}}"], "path": ["timetable","day",""], "query": [ { "key": "date", "value": "2026-08-24" } ] }
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Monthly Attendance",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/attendance/?month=2026-08", "host": ["{{baseUrl}}"], "path": ["attendance",""], "query": [ { "key": "month", "value": "2026-08" } ] }
          }
        }
      ]
    },
    {
      "name": "Exams",
      "item": [
        {
          "name": "Exam Results",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/exams/results/?term=mid", "host": ["{{baseUrl}}"], "path": ["exams","results",""], "query": [ { "key": "term", "value": "mid" } ] }
          }
        }
      ]
    },
    {
      "name": "Assignments",
      "item": [
        {
          "name": "List Assignments",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/assignments/?status=open", "host": ["{{baseUrl}}"], "path": ["assignments",""], "query": [ { "key": "status", "value": "open" } ] }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/status/health/", "host": ["{{baseUrl}}"], "path": ["status","health",""] }
          }
        }
      ]
    }
  ],
  "event": [],
  "variable": [],
  "auth": {}
}
